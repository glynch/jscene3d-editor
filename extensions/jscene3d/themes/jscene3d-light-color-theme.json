	"tokenColors": [
		{
			"settings": { "foreground": "#303846" }
		},
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#5e6d7a", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage.modifier", "storage.type", "keyword.control", "keyword.operator.new"],
			"settings": { "foreground": "#7c3aed" }
		},
		{
			"name": "Types and classes",
			"scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "support.class", "support.type", "storage.type.java"],
			"settings": { "foreground": "#1d4ed8" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
			"settings": { "foreground": "#147d3f" }
		},
		{
			"name": "Numbers and constants",
			"scope": ["constant.numeric", "constant.language.boolean", "constant.language.null"],
			"settings": { "foreground": "#b45309" }
		},
		{
			"name": "Annotations and decorators",
			"scope": ["storage.type.annotation", "entity.name.function.decorator", "meta.annotation", "punctuation.definition.annotation"],
			"settings": { "foreground": "#9a3412" }
		}
	],
	"semanticTokenColors": {
		"comment": { "foreground": "#5e6d7a", "italic": true },
		"keyword": "#7c3aed",
		"class": "#1d4ed8",
		"interface": "#1d4ed8",
		"struct": "#1d4ed8",
		"enum": "#1d4ed8",
		"type": "#1d4ed8",
		"typeParameter": "#1d4ed8",
		"string": "#147d3f",
		"number": "#b45309",
		"decorator": "#9a3412"
	}
}
