	"tokenColors": [
		{
			"settings": { "foreground": "#c9ced8" }
		},
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#8e97a8", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage.modifier", "storage.type", "keyword.control", "keyword.operator.new"],
			"settings": { "foreground": "#c792ea" }
		},
		{
			"name": "Types and classes",
			"scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "support.class", "support.type", "storage.type.java"],
			"settings": { "foreground": "#82aaff" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
			"settings": { "foreground": "#c3e88d" }
		},
		{
			"name": "Numbers and constants",
			"scope": ["constant.numeric", "constant.language.boolean", "constant.language.null"],
			"settings": { "foreground": "#f78c6c" }
		},
		{
			"name": "Annotations and decorators",
			"scope": ["storage.type.annotation", "entity.name.function.decorator", "meta.annotation", "punctuation.definition.annotation"],
			"settings": { "foreground": "#ffcb6b" }
		}
	],
	"semanticTokenColors": {
		"comment": { "foreground": "#8e97a8", "italic": true },
		"keyword": "#c792ea",
		"class": "#82aaff",
		"interface": "#82aaff",
		"struct": "#82aaff",
		"enum": "#82aaff",
		"type": "#82aaff",
		"typeParameter": "#82aaff",
		"string": "#c3e88d",
		"number": "#f78c6c",
		"decorator": "#ffcb6b"
	}
}
