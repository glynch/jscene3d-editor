{
	"name": "jscene3d",
	"displayName": "%displayName%",
	"description": "%description%",
	"publisher": "jscene3d",
	"version": "0.0.1",
	"license": "MIT",
	"engines": {
		"vscode": "^1.138.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"themes": [
			{
				"id": "JScene3D Dark",
				"label": "JScene3D Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/jscene3d-dark-color-theme.json"
			},
			{
				"id": "JScene3D Light",
				"label": "JScene3D Light",
				"uiTheme": "vs",
				"path": "./themes/jscene3d-light-color-theme.json"
			}
		],
		"commands": [
			{
				"command": "jscene3d.showProjectPlaceholder",
				"title": "%command.showProjectPlaceholder%",
				"category": "JScene3D",
				"icon": "$(info)"
			},
			{
				"command": "jscene3d.createProject",
				"title": "%command.createProject%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.openProject",
				"title": "%command.openProject%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.gettingStarted",
				"title": "%command.gettingStarted%",
				"category": "JScene3D"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "jscene3d.showProjectPlaceholder",
					"when": "view == jscene3d.project",
					"group": "navigation"
				}
			]
		},
		"views": {
			"explorer": [
				{
					"id": "jscene3d.project",
					"name": "%view.project%",
					"icon": "$(folder)",
					"visibility": "visible"
				}
			]
		},
		"configuration": {
			"title": "JScene3D",
			"properties": {
				"jscene3d.project.placeholderLabel": {
					"type": "string",
					"default": "Project integration is a Stage 3 placeholder",
					"description": "%configuration.placeholderLabel%"
				}
			}
		},
		"configurationDefaults": {
			"workbench.colorTheme": "JScene3D Dark",
			"workbench.secondarySideBar.defaultVisibility": "hidden",
			"chat.disableAIFeatures": true,
			"chat.agentsControl.enabled": "hidden",
			"chat.viewSessions.enabled": false,
			"chat.titleBar.signIn.enabled": false,
			"chat.titleBar.openInAgentsWindow.enabled": false
		}
	}
}
