{
	"name": "jscene3d",
	"displayName": "%displayName%",
	"description": "%description%",
	"publisher": "jscene3d",
	"version": "0.0.1",
	"license": "MIT",
	"engines": {
		"vscode": "^1.138.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished",
		"onCommand:jscene3d.getRecentProjects",
		"onCommand:jscene3d.openRecentProject"
	],
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"themes": [
			{
				"id": "JScene3D Dark",
				"label": "JScene3D Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/jscene3d-dark-color-theme.json"
			},
			{
				"id": "JScene3D Light",
				"label": "JScene3D Light",
				"uiTheme": "vs",
				"path": "./themes/jscene3d-light-color-theme.json"
			}
		],
		"commands": [
			{
				"command": "jscene3d.createProject",
				"title": "%command.createProject%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.openProject",
				"title": "%command.openProject%",
				"category": "JScene3D",
				"icon": "$(folder-opened)",
				"enablement": "!jscene3d.projectBusy"
			},
			{
				"command": "jscene3d.closeProject",
				"title": "%command.closeProject%",
				"category": "JScene3D",
				"icon": "$(close)",
				"enablement": "jscene3d.projectOpen && !jscene3d.projectBusy"
			},
			{
				"command": "jscene3d.runProject",
				"title": "%command.runProject%",
				"category": "JScene3D",
				"icon": "$(preview)",
				"enablement": "jscene3d.projectOpen && !jscene3d.projectBusy"
			},
			{
				"command": "jscene3d.gettingStarted",
				"title": "%command.gettingStarted%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.sceneView.focusSelected",
				"title": "%command.sceneView.focusSelected%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.sceneView.frameAll",
				"title": "%command.sceneView.frameAll%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.sceneView.resetNavigationSettings",
				"title": "%command.sceneView.resetNavigationSettings%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.sceneView.tool.select",
				"title": "%command.sceneView.tool.select%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.sceneView.tool.move",
				"title": "%command.sceneView.tool.move%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.sceneView.tool.rotate",
				"title": "%command.sceneView.tool.rotate%",
				"category": "JScene3D"
			},
			{
				"command": "jscene3d.sceneView.tool.scale",
				"title": "%command.sceneView.tool.scale%",
				"category": "JScene3D"
			}
		],
		"keybindings": [
			{
				"command": "jscene3d.sceneView.focusSelected",
				"key": "f",
				"when": "activeEditor == workbench.editor.jscene3dRendererPreview && !inputFocus"
			},
			{
				"command": "jscene3d.sceneView.frameAll",
				"key": "home",
				"mac": "home",
				"when": "activeEditor == workbench.editor.jscene3dRendererPreview && !inputFocus"
			},
			{
				"command": "jscene3d.sceneView.tool.select",
				"key": "q",
				"when": "activeEditor == workbench.editor.jscene3dRendererPreview && !inputFocus"
			},
			{
				"command": "jscene3d.sceneView.tool.move",
				"key": "w",
				"when": "activeEditor == workbench.editor.jscene3dRendererPreview && !inputFocus"
			},
			{
				"command": "jscene3d.sceneView.tool.rotate",
				"key": "e",
				"when": "activeEditor == workbench.editor.jscene3dRendererPreview && !inputFocus"
			},
			{
				"command": "jscene3d.sceneView.tool.scale",
				"key": "r",
				"when": "activeEditor == workbench.editor.jscene3dRendererPreview && !inputFocus"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "jscene3d.openProject",
					"when": "view == jscene3d.project && !jscene3d.projectBusy",
					"group": "navigation"
				},
				{
					"command": "jscene3d.closeProject",
					"when": "view == jscene3d.project && jscene3d.projectOpen",
					"group": "navigation"
				},
				{
					"command": "jscene3d.runProject",
					"when": "view == jscene3d.project && jscene3d.projectOpen && !jscene3d.projectBusy",
					"group": "navigation@10"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "jscene3d",
					"title": "%viewsContainer.jscene3d%",
					"icon": "$(type-hierarchy-sub)"
				}
			],
			"secondarySidebar": [
				{
					"id": "jscene3d-inspector",
					"title": "%viewsContainer.inspector%",
					"icon": "resources/jscene3d-mark.svg"
				}
			]
		},
		"views": {
			"jscene3d": [
				{
					"id": "jscene3d.hierarchy",
					"name": "%view.hierarchy%",
					"type": "webview",
					"icon": "$(list-tree)",
					"when": "jscene3d.extensionReady && jscene3d.projectOpen",
					"visibility": "visible"
				},
				{
					"id": "jscene3d.project",
					"name": "%view.project%",
					"icon": "$(folder)",
					"when": "jscene3d.extensionReady",
					"visibility": "collapsed"
				}
			],
			"jscene3d-inspector": [
				{
					"id": "jscene3d.inspector",
					"name": "%view.inspector%",
					"type": "webview",
					"when": "jscene3d.extensionReady",
					"visibility": "visible"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "jscene3d.hierarchy",
				"contents": "%view.hierarchy.noActiveDefinition%",
				"when": "jscene3d.extensionReady && jscene3d.projectOpen && !jscene3d.definitionActive"
			}
		],
		"customEditors": [
			{
				"viewType": "jscene3d.sceneDefinition",
				"displayName": "%customEditor.sceneDefinition%",
				"selector": [
					{ "filenamePattern": "*.scene.json" }
				],
				"priority": "default"
			},
			{
				"viewType": "jscene3d.authoredDefinition",
				"displayName": "%customEditor.authoredDefinition%",
				"selector": [
					{ "filenamePattern": "*.entity.json" }
				],
				"priority": "option"
			}
		],
		"configuration": {
			"title": "JScene3D",
			"properties": {
				"jscene3d.authoring.javaExecutable": {
					"type": "string",
					"default": "java",
					"scope": "machine",
					"description": "%configuration.authoring.javaExecutable%"
				},
					"jscene3d.authoring.modulePath": {
						"type": "string",
						"default": "",
						"scope": "machine",
						"description": "%configuration.authoring.modulePath%"
					},
					"jscene3d.authoring.installedExtensionMetadata": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"scope": "machine",
						"description": "%configuration.authoring.installedExtensionMetadata%"
					},
					"jscene3d.authoring.runtimeArtifacts": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"scope": "machine",
						"description": "%configuration.authoring.runtimeArtifacts%"
					},
					"jscene3d.sceneView.navigation.altDragOrbitEnabled": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.sceneView.navigation.altDragOrbitEnabled%"
					},
					"jscene3d.sceneView.navigation.shiftAltDragPanEnabled": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.sceneView.navigation.shiftAltDragPanEnabled%"
					},
					"jscene3d.sceneView.navigation.middleButtonPanEnabled": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.sceneView.navigation.middleButtonPanEnabled%"
					},
					"jscene3d.sceneView.navigation.scrollZoomEnabled": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.sceneView.navigation.scrollZoomEnabled%"
					},
					"jscene3d.sceneView.navigation.pinchZoomEnabled": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.sceneView.navigation.pinchZoomEnabled%"
					},
					"jscene3d.sceneView.navigation.altRightDragZoomEnabled": {
						"type": "boolean",
						"default": true,
						"description": "%configuration.sceneView.navigation.altRightDragZoomEnabled%"
					},
					"jscene3d.sceneView.navigation.orbitSensitivity": {
						"type": "number",
						"default": 1,
						"minimum": 0.05,
						"maximum": 10,
						"description": "%configuration.sceneView.navigation.orbitSensitivity%"
					},
					"jscene3d.sceneView.navigation.panSensitivity": {
						"type": "number",
						"default": 1,
						"minimum": 0.05,
						"maximum": 10,
						"description": "%configuration.sceneView.navigation.panSensitivity%"
					},
					"jscene3d.sceneView.navigation.zoomSensitivity": {
						"type": "number",
						"default": 1,
						"minimum": 0.05,
						"maximum": 10,
						"description": "%configuration.sceneView.navigation.zoomSensitivity%"
					},
					"jscene3d.sceneView.navigation.invertOrbit": {
						"type": "boolean",
						"default": false,
						"description": "%configuration.sceneView.navigation.invertOrbit%"
					},
					"jscene3d.sceneView.navigation.invertZoom": {
						"type": "boolean",
						"default": false,
						"description": "%configuration.sceneView.navigation.invertZoom%"
					},
					"jscene3d.sceneView.transform.translationSnap": {
						"type": "number",
						"default": 0.5,
						"exclusiveMinimum": 0,
						"description": "%configuration.sceneView.transform.translationSnap%"
					},
					"jscene3d.sceneView.transform.rotationSnap": {
						"type": "number",
						"default": 15,
						"exclusiveMinimum": 0,
						"description": "%configuration.sceneView.transform.rotationSnap%"
					},
					"jscene3d.sceneView.transform.scaleSnap": {
						"type": "number",
						"default": 0.1,
						"exclusiveMinimum": 0,
						"description": "%configuration.sceneView.transform.scaleSnap%"
					}
			}
		},
		"configurationDefaults": {
			"workbench.colorTheme": "JScene3D Dark",
			"workbench.secondarySideBar.defaultVisibility": "visibleInWorkspace",
			"java.compile.nullAnalysis.mode": "disabled",
			"java.import.gradle.enabled": false,
			"chat.disableAIFeatures": true,
			"chat.agentsControl.enabled": "hidden",
			"chat.viewSessions.enabled": false,
			"chat.titleBar.signIn.enabled": false,
			"chat.titleBar.openInAgentsWindow.enabled": false
		}
	}
}
