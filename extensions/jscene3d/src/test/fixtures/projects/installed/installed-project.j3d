{
	"$schema": "https://jscene3d.org/schemas/project-1.json",
	"schemaVersion": 1,
	"identity": {
		"id": "example.authoring-test",
		"name": "Installed Metadata Project",
		"version": "1.2.3"
	},
	"engine": {
		"requires": ">=0.1.0-SNAPSHOT <0.2.0"
	},
	"runtime": {
		"applicationExtension": "example.authoring-test",
		"entryScene": "worlds/main.world.json"
	},
	"extensions": [
		{
			"id": "example.authoring-test",
			"requires": ">=1.0.0 <2.0.0"
		},
		{
			"id": "example.installed",
			"requires": ">=1.0.0 <2.0.0"
		}
	]
}
